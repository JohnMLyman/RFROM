% clear
% close all
temp_file='N:\erddap_filt\temp_novert_2024netcdf_loess_stable_1x1\tree_temp_novert\yearly_withcycle\RFROM_TEMP_1x1xmonth_v21_paige.nc';

% temp_file='N:\erddap_filt\temp_novert_sulu_2025_eqbox_seanetcdf_1x1\tree_temp_novert\yearly_withcycle\RFROM_TEMP_1x1xmonth_v22_paige.nc';
% temp_file='G:\H_error_netcdf_drive\erddap_filt\temp_novert_2023netcdf_loess_stable_1x1\tree_temp_novert\yearly_withcycle\RFROM_TEMP_1x1xmonth_v21.nc';
% temp_file='G:\H_error_netcdf_drive\erddap_filt\temp_vert_2023netcdf_loess_stable_1x1\tree_temp_vert_nosshsst_newcycle\yearly_withcycle\RFROM_TEMP_1x1xmonth_v2.nc';

path_nino='C:\Users\jlyma\OneDrive\Documents\MATLAB\RFROM\GREG_CODE\';


% % dd=dir('/Users/gjohnson/RFROM/RFROM_TEMP_1x1xmonth_v21_paige.nc');
% dd=dir('/Users/gjohnson/RFROM/RFROM_TEMP_1x1xmonth_v2.nc');

% ee=dir('/Users/gjohnson/RFROM/Salinity/RFROM_SAL_STABLE_1x1xmonth.nc');

lat2=double(ncread(temp_file,'latitude'));
lon=double(ncread(temp_file,'longitude'));
prs=double(ncread(temp_file,'mean_pressure'));
tim=double(ncread(temp_file,'time'));
ct=double(ncread(temp_file,'ocean_temperature'));
% sa=double(ncread(['/Users/gjohnson/RFROM/Salinity/',ee(1).name],'ocean_salinity'));

% KLUDGE FOR v21_paige

ct=ct(:,:,:,1:378);
tim=tim(1:378);

% jul=juliandate(1950,1,1); % julian days at 1 Jan 1950
greg=datevec(tim+datenum(1950,1,1));; % get gregorian days
dyr=decyear(greg(:,1),greg(:,2),greg(:,3)); % change to decimal years
   

q=load([path_nino,'detrend.nino34.ascii.txt']);

oni=q(:,5);
oni_dyr=q(:,1)+q(:,2)/12-1/24;

ii=find(round(oni_dyr*24)>=min(round(dyr*24))&round(oni_dyr*24)<=max(round(dyr*24)));

oni=oni(ii);
oni_dyr=oni_dyr(ii);

dprs=[5,10+0*[1:17],15,20+0*[19:31],25,50+0*[33:50],75,100+0*[52:56],50];
 
clear dd jul greg q ii

mid_year=2008.5;

[m,n,o,p]=size(ct);

maxlag=48;
ct_mod_coeffs=NaN*ones(m,n,o,13);
ct_res=NaN*ct;
ct_cor_max_ub=NaN*ones(m,n,o);
ct_cor_lag_ub=ct_cor_max_ub;
ct_cor_max_co=ct_cor_max_ub;
ct_cor_lag_co=ct_cor_max_ub;
ct_cor_ub=NaN*ones(m,n,o,maxlag*2+1);
ct_cor_co=ct_cor_ub;
ct_res_std=NaN*ones(m,n,o);

tic
for i1=1:m
    for i2=1:n
        for i3=1:o
            ct_temp=squeeze(ct(i1,i2,i3,:));
            ii=find(isfinite(ct_temp)==1);
            % if length(ii)>50
            if length(ii)==p
                [mod_temp,res_temp]=fit_trend_seasonal_cycle(dyr(ii),ct_temp(ii),2,mid_year);
                ct_mod_coeffs(i1,i2,i3,:)=mod_temp;
                ct_res(i1,i2,i3,ii)=res_temp;
                ct_res_std(i1,i2,i3)=std(res_temp);
                [cor_ub,lag_ub]= xcorr(oni(ii),res_temp,maxlag,'unbiased');
                [cor_co,lag_co]= xcorr(oni(ii),res_temp,maxlag,'coeff');
                jj=find(abs(cor_ub)==max(abs(cor_ub)));
                ct_cor_lag_ub(i1,i2,i3)=lag_ub(jj(1));
                ct_cor_max_ub(i1,i2,i3)=cor_ub(jj(1));
                ct_cor_lag_co(i1,i2,i3)=lag_co(jj(1));
                ct_cor_max_co(i1,i2,i3)=cor_co(jj(1));
                ct_cor_ub(i1,i2,i3,:)=cor_ub;
                ct_cor_co(i1,i2,i3,:)=cor_co;
                % ct_cor(i1,i2,i3,:)=cor;
            end
        end
    end
    disp(i1)
    toc
end


