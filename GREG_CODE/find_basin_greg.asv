function [global_basins]=find_basin_greg(lon,lat)




%% Split data into overlapping, regional subsets
%Set up to run on data coordinates given as N x 2 matrix called lat where N
%is number of observations and longitude is from 0° to 360°. Results in
%lists of lat coordinates found in each of the following basins (with 
%overlap between Atlantic/Indian/Pacific in Southern Ocean): Atlantic,
%Indian, Pacific, and Arctic oceans; Mediterranean, Black, Caribbean, and
%Red seas.
%Updated: 10/15/21 paige.lavin@noaa.gov


% if lon is from -180 to 180.  first thing that it does
% is convert it to 30 to 390.  Both lon and lat can either be a matrix or
% vector

if min(lon(:))<30
    lon(lon<0)=lon(lon<0)+360;
end

lon_360=lon;
lon_360(lon_360<180)=lon_360(lon_360<180)+360;


%  load in Gregs bounaries and convert them to my own
load('C:\Users\jlyma\OneDrive\Documents\MATLAB\RFROM\GREG_CODE\borders.mat')

x_atl=a1';
y_atl=a2';

x_ind1=ie1';
y_ind1=ie2';

x_ind2=iw1';
y_ind2=iw2';

x_pac=p1';
y_pac=p2';




%Check for points in each basin in lat data
in_ind2 = inpolygon(lon,lat,x_ind2,y_ind2);
in_ind1 = inpolygon(lon,lat,x_ind1,y_ind1);
in_ind=in_ind1|in_ind2;

in_pac = inpolygon(lon,lat,x_pac,y_pac);
in_atl = inpolygon(lon,lat,x_atl,y_atl);




in_else=~(in_ind|in_pac|in_atl);




global_basins(1).name='indian ocean';
global_basins(1).pos=in_ind;
global_basins(2).name='pacific ocean';
global_basins(2).pos=in_pac;
global_basins(3).name='atlantic ocean';
global_basins(3).pos=in_atl;
global_basins(4).name='else';
global_basins(4).pos=in_else;


