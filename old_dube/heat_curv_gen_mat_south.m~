function [hc_north,hc_south,hc,time]=heat_curv_gen_mat_south(file_name,lat_cut)
load ../../Mtpers/meanssh lat lon sshmean
% to get rid of ice
sshmean=[sshmean(542:end,:);sshmean(1:541,:)];

lon_tpx=[lon(542:end)-360;lon(1:541)];
lat_tpx=lat;
arw=areavec(lon_tpx,lat_tpx);
clear lon lat

load ../../HC/landmask msk2
eval(['load ' file_name]);
 

 north=find(lat_tpx >= lat_cut);

 south=find(lat_tpx < lat_cut);
lat_tpx_south=lat_tpx(south);
lat_tpx_north=lat_tpx(north);
 for i=1:length(time)


corrhc=interp2(lat,lon,ht(:,:,i),lat_tpx,lon_tpx')./1e9;
corrhc(isnan(msk2(2:end-1,:)))=NaN;
corrhc(isnan(sshmean))=NaN;

corrhc_one=interp2(lat,lon,one(:,:,i),lat_tpx,lon_tpx');
corrhc_one(isnan(msk2(2:end-1,:)))=NaN;
corrhc_one(isnan(sshmean))=NaN;





Area=sum(arw(~isnan(corrhc)));
% compute the area average heatcontent across the globe.

corrhc_south=corrhc(:,south);
corrhc_north=corrhc(:,north);
arw_north=arw(:,north);
arw_south=arw(:,south);
hc_north(i)=1e9.*nansum(arw_north(:).*corrhc_north(:))/sum(arw_north(~isnan(corrhc_north)));
hc_south(i)c=1e9.*nansum(arw_south(:).*corrhc_south(:))/sum(arw_south(~isnan(corrhc_south)));

hc(i)=1e9.*nansum(arw(:).*corrhc(:))/sum(arw(~isnan(corrhc)));
hc_one(i)=nansum(arw(:).*corrhc_one(:))/sum(arw(~isnan(corrhc_one)));

time_hc(i)=time(i);



end

area_of_earth=5.1e14;
hc=hc*3.4e14;
hc_south=hc_south*3.4e14;
hc_north=hc_north*3.4e14;



 hc_one=hc./hc_one;
