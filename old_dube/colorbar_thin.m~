% color bar bottom this code makes a thin color bar at the bottom

delta=10

j=axes;
[cs,h]=contourf([0 1],[-100:delta:100],[[1 1]'*[-100:delta:100]]',[-100:delta:100]);
set(h,'edgecolor','none');
hold on[cs,h]=contourf([1 1],[-100 100],[[-8:8]'*[0 1]],[-100:50:100]);
set(j,'pos',[0.1 0.05 0.02 0.9],'tickdir','out','xtick',[],'ytick',[-100:delta:100],'ticklen',[0 0])
ylabel('W/m^2')
[cs1,h1]=contour([0 1],[-100:10:100],[[1 1]'*[-100:10:100]]',[10:10:100],'k-');
[cs2,h2]=contour([0 1],[-100:10:100],[[1 1]'*[-100:10:100]]',[-100:10:0],'k-');
set(h1,'linew',1)
set(h2,'linew',0.5)
%caxis([-10 6])